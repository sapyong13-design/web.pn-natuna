# Salin ke /home/USER/private/cron/pn-natuna.env lalu chmod 600.
# Ganti seluruh nilai USER dan database sebelum digunakan.
PN_NATUNA_JPATH_ROOT=/home/USER/public_html
PN_NATUNA_SOURCE_ROOT=/home/USER/repos/web.pn-natuna
PN_NATUNA_PRIVATE_ROOT=/home/USER/private
PHP_BIN=/usr/local/bin/php
PYTHON_BIN=/usr/bin/python3
MYSQL_BIN=/usr/bin/mysql
MYSQL_DEFAULTS_FILE=/home/USER/private/cron/mysql.cnf
DB_NAME=USER_nama_database
PN_NATUNA_PUBLIC_URL=https://pn-natuna.go.id

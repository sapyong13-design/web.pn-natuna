	RewriteRule ^(?:index\.php/(?:en/)?)?component/users/(?:reset|remind)/?$ - [G,L,NC]
	RewriteRule ^index\.php/en/?$ / [R=301,L,NE]
  RewriteRule ^index\.php/en/about/profil-hakim-dan-pegawai/profil-hakim/?$ /profil-pengadilan/profil-hakim [R=301,L,NE,NC]

## Deployed Apache rules. Keep synchronized with htaccess.txt.
Options +FollowSymlinks
Options -Indexes

<IfModule mod_autoindex.c>
	IndexIgnore *
</IfModule>
<IfModule mod_setenvif.c>
	SetEnvIf Host ^new\.pn-natuna\.go\.id$ STAGING
</IfModule>
<IfModule mod_headers.c>
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	Header always unset X-Powered-By
	## Satu minggu tanpa includeSubDomains: cukup kuat untuk production utama,
	## tetap aman bagi aplikasi legacy pada subdomain yang dikelola terpisah.
	Header always set Strict-Transport-Security "max-age=604800" env=HTTPS
	Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=STAGING
	Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://www.google.com; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://www.instagram.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; frame-src 'self' https://challenges.cloudflare.com https://www.google.com https://www.instagram.com https://www.youtube-nocookie.com; connect-src 'self' https://www.instagram.com; media-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests"
</IfModule>
<FilesMatch "\.svg$">
	<IfModule mod_headers.c>
		Header always set Content-Security-Policy "script-src 'none'"
	</IfModule>
</FilesMatch>

## --- Kompresi dan cache aset statis ---------------------------------------
## Aset template disajikan langsung oleh Apache, di luar jangkauan `$gzip` di
## configuration.php yang hanya memampatkan keluaran HTML dari PHP. Tanpa blok
## ini `templates/pn_natuna_2026/css/template.css` dikirim 387 KB mentah kepada
## setiap pengunjung; terkompresi menjadi sekitar 71 KB. Untuk pengguna di
## wilayah kepulauan dengan koneksi tidak stabil, selisih itu bukan angka
## teknis.
##
## Cache panjang aman karena index.php menempelkan `?v=filemtime` pada CSS/JS
## dan tools/deploy-cpanel.py menyalin dengan shutil.copy2 yang mempertahankan
## mtime sumber, sehingga nilai buster berubah tepat ketika isi berkas berubah.
## `AddOutputFilterByType` disediakan mod_filter, BUKAN mod_deflate. Menjaga
## blok ini hanya dengan `<IfModule mod_deflate.c>` membuat seluruh situs
## membalas 500 pada host yang memuat deflate tanpa filter — sudah terbukti di
## Apache 2.4.66 lokal. Kedua modul wajib disyaratkan bersarang.
<IfModule mod_filter.c>
	<IfModule mod_deflate.c>
		AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
		AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
		AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
		AddOutputFilterByType DEFLATE image/svg+xml application/vnd.ms-fontobject
	</IfModule>
	<IfModule mod_brotli.c>
		AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
		AddOutputFilterByType BROTLI_COMPRESS application/javascript text/javascript
		AddOutputFilterByType BROTLI_COMPRESS application/json application/xml image/svg+xml
	</IfModule>
</IfModule>
<IfModule mod_setenvif.c>
	## WebP, JPEG, PNG, dan WOFF2 sudah terkompresi di dalam formatnya sendiri;
	## memampatkan ulang hanya membakar CPU tanpa mengurangi byte.
	SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|ico|zip|gz|woff2?)$ no-gzip dont-vary
</IfModule>
<IfModule mod_expires.c>
	ExpiresActive On
	## CSS/JS memakai cache-buster, tetapi 30 hari dipilih alih-alih satu tahun
	## supaya kekeliruan deploy dapat pulih sendiri tanpa meminta pengunjung
	## membersihkan cache.
	ExpiresByType text/css "access plus 30 days"
	ExpiresByType text/javascript "access plus 30 days"
	ExpiresByType application/javascript "access plus 30 days"
	## Nama berkas gambar dan font berubah ketika isinya diganti.
	ExpiresByType font/woff2 "access plus 1 year"
	ExpiresByType font/woff "access plus 1 year"
	ExpiresByType image/webp "access plus 1 year"
	ExpiresByType image/avif "access plus 1 year"
	ExpiresByType image/jpeg "access plus 1 year"
	ExpiresByType image/png "access plus 1 year"
	ExpiresByType image/svg+xml "access plus 1 year"
	ExpiresByType image/x-icon "access plus 1 year"
	## HTML tidak pernah di-cache: jadwal sidang, status PTSP, dan berita
	## berubah tanpa mengubah URL-nya.
	ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_authz_core.c>
	<FilesMatch "(^\.|configuration\.php$|(?:^|\.)(?:env|ini|log|sql|sqlite|dump|bak|backup|old|orig|save|swp|pem|key|p12|pfx)(?:\.|$)|(?:composer|package)-lock\.json$|composer\.json$)">
		Require all denied
	</FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
	<FilesMatch "(^\.|configuration\.php$|(?:^|\.)(?:env|ini|log|sql|sqlite|dump|bak|backup|old|orig|save|swp|pem|key|p12|pfx)(?:\.|$)|(?:composer|package)-lock\.json$|composer\.json$)">
		Order allow,deny
		Deny from all
	</FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
	RewriteEngine On
	## Paksa HTTPS sebelum Joomla membuat sesi. Kondisi X-Forwarded-Proto mencegah
	## redirect-loop ketika TLS berakhir di Cloudflare/LiteSpeed reverse proxy.
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
	RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]
	## Pindahkan sinyal indeks Joomla lama ke route rebuild. Aturan eksplisit
	## mendahului fallback bahasa agar URL bernilai tinggi tidak berakhir 404.
	RewriteRule ^index\.php/en/?$ / [R=301,L,NE]
  RewriteRule ^index\.php/en/about/profil-hakim-dan-pegawai/profil-hakim/?$ /profil-pengadilan/profil-hakim [R=301,L,NE,NC]
  RewriteRule ^index\.php/en/about/profil-hakim-dan-pegawai/?$ /profil-pengadilan [R=301,L,NE,NC]
  RewriteRule ^index\.php/en/hubungi-kami/alamat/?$ /kontak [R=301,L,NE,NC]
  RewriteRule ^about/profil-hakim-dan-pegawai/profil-hakim/?$ /profil-pengadilan/profil-hakim [R=301,L,NE,NC]
  RewriteRule ^about/profil-hakim-dan-pegawai/?$ /profil-pengadilan [R=301,L,NE,NC]
  RewriteRule ^hubungi-kami/alamat/?$ /kontak [R=301,L,NE,NC]
	RewriteRule ^index\.php/en/(?:about|tentang-pengadilan)/?$ /profil-pengadilan [R=301,L,NE,NC]
	RewriteRule ^index\.php/en/hubungi-kami/?$ /kontak [R=301,L,NE,NC]
	RewriteRule ^index\.php/en/berita/(?:artikel|berita-terkini|photo-gallery)/?$ /berita-dan-pengumuman/berita [R=301,L,NE,NC]
	RewriteRule ^index\.php/en/layanan-publik/pengumuman/?$ /berita-dan-pengumuman/pengumuman [R=301,L,NE,NC]
	RewriteRule ^index\.php/en/layanan-publik/laporan/sakip/?$ /transparansi/sakip [R=301,L,NE,NC]
	RewriteRule ^index\.php/en/layanan-publik/laporan/lhkpn/?$ /transparansi/lhkpn [R=301,L,NE,NC]
	RewriteRule ^index\.php/en/(.*)$ /$1 [R=301,L,NE,NC]
	RewriteRule ^index\.php/?$ / [R=301,L,NE]
	RewriteRule "(?:^|/)(?:\.git|\.svn|database|docs|tools)(?:/|$)" - [F,END,NC]
	## Situs tidak memakai Joomla Web Services. Tutup API di origin; edge wajib sama.
	RewriteRule ^api(?:/|$) - [F,END,NC]
	## Direktori upload/cache boleh ditulis, tetapi tidak boleh mengeksekusi PHP.
	RewriteRule ^(?:images|files|cache|tmp)/.*\.(?:php[0-9]?|phtml|phar)$ - [F,END,NC]
	RewriteCond %{QUERY_STRING} base64_encode[^(]*\([^)]*\) [OR]
	RewriteCond %{QUERY_STRING} (<|%3C)([^s]*s)+cript.*(>|%3E) [NC,OR]
	RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
	RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2})
	RewriteRule .* index.php [F]
	RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
	RewriteCond %{REQUEST_URI} ^/api/
	RewriteCond %{REQUEST_URI} !^/api/index\.php
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule .* api/index.php [L]
	RewriteCond %{REQUEST_URI} !^/index\.php
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule .* index.php [L]
</IfModule>
<IfModule !mod_rewrite.c>
	<IfModule mod_alias.c>
		RedirectMatch 302 ^/$ /index.php/
	</IfModule>
</IfModule>
